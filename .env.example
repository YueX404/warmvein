# =============================================================================
# 暖脉 AI 智慧供热平台 — 环境变量配置模板
# 使用方式: 复制为 .env 并填入实际值
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# FastAPI 服务
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development                    # development | production
APP_SECRET_KEY=change-me-to-random-64-chars
APP_CORS_ORIGINS=*                     # 逗号分隔，生产环境限定域名
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# MySQL 8
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=warmvein
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=warmvein

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                        # 留空表示无密码
REDIS_DB=0
REDIS_KEY_PREFIX=warmvein:             # 键前缀，避免多项目冲突

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092  # 多节点逗号分隔
KAFKA_SENSOR_TOPIC=heat-sensor-topic   # 传感器数据 Topic
KAFKA_ALARM_TOPIC=heat-alarm-topic     # 告警事件 Topic
KAFKA_CONSUMER_GROUP=warmvein-consumer
KAFKA_AUTO_OFFSET_RESET=earliest       # earliest | latest

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ES_HOSTS=http://localhost:9200
ES_INDEX_PREFIX=heat-sensor            # 索引前缀，后接日期

# -----------------------------------------------------------------------------
# Spark / Hive
# -----------------------------------------------------------------------------
SPARK_MASTER=spark://spark-master:7077
HIVE_METASTORE_URI=thrift://hive-metastore:9083

# -----------------------------------------------------------------------------
# 短信服务
# -----------------------------------------------------------------------------
SMS_PROVIDER=local                     # aliyun | tencent | local(模拟)
SMS_ACCESS_KEY_ID=                     # 阿里云/腾讯云 AccessKey
SMS_ACCESS_KEY_SECRET=                 # 阿里云/腾讯云 Secret
SMS_SIGN_NAME=暖脉供热                  # 短信签名
SMS_TEMPLATE_CODE=                     # 短信模板编码（如 SMS_xxx）
SMS_DAILY_LIMIT=20                     # 单号每日上限
SMS_RETRY_COUNT=3                      # 失败重试次数
SMS_RETRY_BASE_DELAY=2                 # 重试基础间隔(秒)

# -----------------------------------------------------------------------------
# ML 模型
# -----------------------------------------------------------------------------
MODEL_DIR=models                       # 模型文件目录（相对项目根）
MODEL_ANOMALY=anomaly_model.pkl        # 异常检测模型
MODEL_LIFETIME=lifetime_model.pkl      # 剩余寿命模型
MODEL_USER_ABNORMAL=user_abnormal_model.pkl  # 用热异常模型

# -----------------------------------------------------------------------------
# 气候补偿默认参数（安塞区）
# -----------------------------------------------------------------------------
CLIMATE_TN=18.0                        # 室内设计温度(℃)
CLIMATE_TG_D=75.0                      # 设计供水温度(℃)
CLIMATE_TW_D=-9.0                      # 设计室外温度(℃)
CLIMATE_DT_D=25.0                      # 设计供回水温差(℃)

# -----------------------------------------------------------------------------
# 水力平衡阈值
# -----------------------------------------------------------------------------
BALANCE_BETA_MIN=0.9                   # 平衡度下限
BALANCE_BETA_MAX=1.1                   # 平衡度上限

# -----------------------------------------------------------------------------
# 冻堵风险参数
# -----------------------------------------------------------------------------
FREEZE_VELOCITY_MIN=0.2               # 最低流速(m/s)

# -----------------------------------------------------------------------------
# Docker Compose 扩展（仅 docker-compose.yml 引用时需要）
# -----------------------------------------------------------------------------
# ZOOKEEPER_CLIENT_PORT=2181
# KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9093
# ES_JAVA_OPTS=-Xms512m -Xmx512m
# HADOOP_HEAPSIZE=1024
# HIVE_METASTORE_HEAPSIZE=1024
